<?xml version="1.0" encoding="UTF-8" ?>

<persistence xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             version="2.0"
             xmlns="http://java.sun.com/xml/ns/persistence"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd">

    <!-- Create Persistence-Unit -->
    <persistence-unit name="book" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>at.fhburgenland.model.Book</class>
        <class>at.fhburgenland.model.BookAuthor</class>
        <class>at.fhburgenland.model.BookGenre</class>
        <class>at.fhburgenland.model.BookPublisher</class>
        <class>at.fhburgenland.model.BookStockLog</class>
        <class>at.fhburgenland.model.Country</class>
        <class>at.fhburgenland.model.Customer</class>
        <class>at.fhburgenland.model.Event</class>
        <class>at.fhburgenland.model.EventType</class>
        <class>at.fhburgenland.model.Street</class>
        <class>at.fhburgenland.model.Town</class>
        <class>at.fhburgenland.model.Zip</class>
        <class>at.fhburgenland.model.CustomerEventMap</class>
        <class>at.fhburgenland.model.BookCirculationLog</class>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/dbjava"/>
            <property name="jakarta.persistence.jdbc.user" value="bswe"/>

            <property name="jakarta.persistence.jdbc.password" value="fogl"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>
    <persistence-unit name="book-unit-test" transaction-type="RESOURCE_LOCAL">
        <class>at.fhburgenland.model.Book</class>
        <class>at.fhburgenland.model.BookAuthor</class>
        <class>at.fhburgenland.model.BookGenre</class>
        <class>at.fhburgenland.model.BookPublisher</class>
        <class>at.fhburgenland.model.BookStockLog</class>
        <class>at.fhburgenland.model.Country</class>
        <class>at.fhburgenland.model.Customer</class>
        <class>at.fhburgenland.model.Event</class>
        <class>at.fhburgenland.model.EventType</class>
        <class>at.fhburgenland.model.Street</class>
        <class>at.fhburgenland.model.Town</class>
        <class>at.fhburgenland.model.Zip</class>
        <properties>
            <!-- JDBC Database Connection Settings -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Hibernate ORM Configuration -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>